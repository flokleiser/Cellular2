                    asset inputs:file = @Nucleus_New/Material.004_Base_color.png@
                    float2 inputs:st.connect = </Root/Nucleus/Materials/Material_004/diffuseColor/TexCoordReader.outputs:result>
                    float3 outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/Nucleus/Materials/Material_004.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }

            over "Material_027"
            {
                token cullMode = "unspecified" (
                    allowedTokens = ["unspecified", "none", "front", "back"]
                )
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                over "PreviewSurface"
                {
                    float3 inputs:diffuseColor.connect = </Root/Nucleus/Materials/Material_027/diffuseColor.outputs:rgb>
                    float inputs:roughness.connect = </Root/Nucleus/Materials/Material_027/roughness.outputs:r>
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @Nucleus_New/Material.004_Roughness.png@
                    float2 inputs:st.connect = </Root/Nucleus/Materials/Material_027/roughness/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/Nucleus/Materials/Material_027.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @Nucleus_New/Material.004_Base_color.png@
                    float2 inputs:st.connect = </Root/Nucleus/Materials/Material_027/diffuseColor/TexCoordReader.outputs:result>
                    float3 outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/Nucleus/Materials/Material_027.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }
        }
    }

    def "Golgi_New" (
        active = true
        references = @Golgi_New.usdz@
    )
    {
        quatf xformOp:orient = (0.7071067, -0.7071068, 0, 0)
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (-20.189184, 0, 56.37644)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Material "Gelb"
    {
        token outputs:mtlx:surface
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/Gelb/UsdPreviewSurface.outputs:surface>

        def Shader "UsdPreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7909351, 0.7434345, 0.15296713) (
                colorSpace = "srgb_texture"
            )
            float inputs:opacity = 0.5944531
            token outputs:surface
        }
    }

