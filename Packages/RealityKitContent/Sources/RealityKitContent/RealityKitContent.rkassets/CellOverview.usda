#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Golgi", "ER", "ER_New2", "Cellmembrane", "Mitochondrion_New", "Ribosomes_New2", "Nucleus", "Golgi_New", "Gelb"]
    def Xform "Golgi" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @Golgi.usdc@
    )
    {
        rel material:binding = </Root/Gelb> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double3 xformOp:translate = (1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "ER" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @ER.usdc@
    )
    {
        rel material:binding = </Root/ER/_materials/Material_015> (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (2.2316391, 0, 30.60516)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_materials"
        {
            over "Material_015"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Material_005"
            {
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                def Shader "opacity"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures_test/Material.005_Normal_OpenGL.png@
                    float2 inputs:st.connect = </Root/ER/_materials/Material_005/opacity/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/ER/_materials/Material_005.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                over "Principled_BSDF"
                {
                    delete float inputs:opacity.connect = </Root/ER/_materials/Material_005/opacity.outputs:r>
                    prepend float inputs:opacity.connect = </Root/ER/_materials/Material_005/opacity.outputs:r>
                }
            }
        }
    }

    def "ER_New2" (
        active = true
        references = @ER_NEW/ER_New2.usdz@
    )
    {
        quatf xformOp:orient = (0.68388045, -0.6838805, -0.17974274, -0.17974275)
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (-20.20602, -1.1641532e-10, 56.246277)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "Cellmembrane" (
        active = true
        references = @Cellmembrane.usdz@
    )
    {
        quatf xformOp:orient = (0.71305776, -0.27137423, -0.5908138, 0.2623807)
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (-20.18427, 0, 56.38073)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "Mitochondrion_New" (
        active = true
        references = @Mitochondrion_New.usdz@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (-20.16799, 0, 56.37893)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Materials"
        {
            over "Material_007"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Material_008"
            {
                token cullMode = "none" (
                    allowedTokens = ["unspecified", "none", "front", "back"]
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }
        }
    }

    def "Ribosomes_New2" (
        active = true
        references = @Ribosomes_New2.usdz@
    )
    {
        quatf xformOp:orient = (1, -3.7748954e-8, 0, 0)
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (-20.168396, 0, 56.380264)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Materials"
        {
            over "Material_015"
            {
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                over "PreviewSurface"
                {
                    float3 inputs:diffuseColor.connect = </Root/Ribosomes_New2/Materials/Material_015/diffuseColor.outputs:rgb>
                    float inputs:roughness.connect = </Root/Ribosomes_New2/Materials/Material_015/roughness.outputs:r>
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @mito_texture/Material.008_roughness.jpg@
                    float2 inputs:st.connect = </Root/Ribosomes_New2/Materials/Material_015/roughness/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/Ribosomes_New2/Materials/Material_015.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @Ribosome_New2/Material.015_baseColor.png@
                    float2 inputs:st.connect = </Root/Ribosomes_New2/Materials/Material_015/diffuseColor/TexCoordReader.outputs:result>
                    float3 outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/Ribosomes_New2/Materials/Material_015.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }
        }
    }

    def "Nucleus" (
        active = true
